## .NET / Visual Studio gitignore

# Build output
bin/
obj/

# Visual Studio files (NEVER commit these - they're machine-specific)
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider IDE
.idea/
*.sln.iml

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Environment / secrets (NEVER commit these)
*.env
appsettings.Development.json
appsettings.Local.json

# Test results
TestResults/
coverage/
*.coverage
*.coveragexml

# Entity Framework migrations (keep Migrations folder but ignore snapshots if needed)
# Uncomment below only if you want to exclude migrations:
# **/Migrations/

# Logs
logs/
*.log
